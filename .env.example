AUTH_SECRET="pos-system-dev-secret-key-2026"

# --- SQLite (modo local, recomendado para desarrollo) ---
DATABASE_URL="file:./prisma/dev.db"

# --- PostgreSQL (para producción con grandes volúmenes de datos) ---
# Para migrar a PostgreSQL:
# 1. Cambia el provider en prisma/schema.prisma de "sqlite" a "postgresql"
# 2. Descomenta la línea de abajo y configura tu conexión
# 3. Ejecuta: npx prisma db push
# DATABASE_URL="postgresql://usuario:password@localhost:5432/pos_system?schema=public"

# No usar AUTH_URL/NEXTAUTH_URL: con `trustHost: true` NextAuth deriva la URL
# base del Host de cada request, asi el login funciona desde localhost y desde
# http://IP-LAN:PUERTO (telefono/tablet). Si AUTH_URL esta definida, el login
# redirige SIEMPRE a esa URL y desde el telefono apunta a su propio localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Sincronizacion P2P (opcional) ---
# Secreto compartido entre equipos para proteger los endpoints /api/sync/*.
# Si se deja vacio, la sincronizacion P2P queda abierta dentro de la red local.
# Debe ser el MISMO valor en todos los dispositivos.
# SYNC_SECRET="cambiar-por-un-secreto-de-sync"

# --- Relay (sincronizacion por internet, opcional) ---
# Secreto compartido con el relay central (buzon en la nube) para sincronizar
# equipos en redes distintas. Debe ser el MISMO en todos los dispositivos y
# en el relay. Se configura tambien desde la UI (Sincronizacion > Relay).
# RELAY_URL="https://tu-dominio.com"
# RELAY_SECRET="un-secreto-largo-y-seguro"
